# Minimal ramdisk /vendor/build.prop for redfin recovery.
# Values read live from stock (slot _b, UP1A/B2 lineage, vendor patch
# 2026-07-05). Recovery's Reset_Prop_From_Partition reads these when stock
# vendor isn't mounted (hybrid); when stock vendor IS mounted its own file
# (same values) wins. Either way the TA-facing patchlevels stay correct.
ro.board.platform=lito
ro.vendor.build.security_patch=2026-07-05
ro.crypto.volume.metadata.method=dm-default-key
ro.crypto.dm_default_key.options_format.version=2
external_storage.casefold.enabled=1
external_storage.sdcardfs.enabled=0
